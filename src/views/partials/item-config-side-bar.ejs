<div id="config-bar">
    <div class="deal-percentage-container">
        <span class="deal-percentage-text">Deal Percentage</span>
        <div class="slider-container">
            <input id="slider" type="range" min="0" max="100" value="0">
            <div class="slider-value-container">
                <input id="slider-value" type="number">
                <span class="slider-value-percentage">%</span>
            </div>
        </div>
    </div>
</div>